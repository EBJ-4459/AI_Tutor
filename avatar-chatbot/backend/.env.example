# ---------- LLM ----------
# gemini | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=700
MAX_HISTORY_MESSAGES=30
ASSISTANT_NAME=Aria
SYSTEM_PROMPT=

# ---------- TTS ----------
# edge (free, no key, real word timings) | elevenlabs | openai
TTS_PROVIDER=edge
EDGE_VOICE=en-US-AriaNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ---------- STT fallback (browsers without Web Speech API) ----------
# Uses OPENAI_API_KEY
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# ---------- Avatar ----------
# Any TalkingHead-compatible GLB (ARKit + Oculus viseme blendshapes).
AVATAR_URL=https://cdn.jsdelivr.net/gh/met4citizen/TalkingHead@1.7/avatars/brunette.glb
AVATAR_BODY=F
LIPSYNC_LANG=en

# ---------- Security ----------
# If set, every REST call and the WebSocket require this token.
APP_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
MAX_MESSAGE_CHARS=2000
RATE_LIMIT_PER_MINUTE=20
DB_PATH=chat.db
